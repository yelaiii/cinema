{
  "language_servers": [
    "vtsls",
    "oxfmt",
    "oxlint",
    "json-language-server",
    "tailwindcss-language-server",
    "yaml-language-server"
  ],
  "format_on_save": "on",
  "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }],
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cn"]
      }
    }
  }
}
